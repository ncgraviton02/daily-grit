---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const digests = await getCollection('digests');
  return digests.map((digest) => ({
    params: { date: digest.slug },
    props: { digest },
  }));
}

const { digest } = Astro.props;
const { data } = digest;

const sectionLabels: Record<string, string> = {
  'ai-agents': 'Artificial Intelligence',
  'claudecode': 'Developer Tools',
  'saas': 'Business & Startups',
  'digitalmarketing': 'Marketing & Growth',
  'philosophy': 'Ideas & Philosophy',
};
---

<BaseLayout title={`${data.title} | The Daily Grit`}>
  <Masthead date={data.date.toISOString()} showTagline={false} />
  
  <article class="digest">
    <header class="digest-header">
      <h1 class="digest-title">{data.title}</h1>
    </header>
    
    {data.sections.map((section, si) => (
      <section class="section">
        <div class="section-rule-container">
          <hr class="section-rule" />
          <div class="section-label-row">
            <span class="section-label">{sectionLabels[section.icon] || section.name}</span>
            <span class="section-source">{section.name}</span>
          </div>
        </div>
        
        <div class={`section-posts ${section.posts.length >= 3 ? 'layout-featured' : 'layout-standard'}`}>
          {section.posts.map((post, pi) => (
            <article class={`post ${pi === 0 && section.posts.length >= 3 ? 'post-lead' : 'post-standard'}`}>
              <h3 class="post-headline">
                {post.permalink ? (
                  <a href={post.permalink} target="_blank" rel="noopener noreferrer">{post.title}</a>
                ) : post.title}
              </h3>
              
              <div class="post-stats">
                <span class="stat">{post.score} points</span>
                <span class="stat-sep">&middot;</span>
                <span class="stat">{post.comments} comments</span>
              </div>
              
              <p class="post-body">{post.summary}</p>
              
              {post.topComments && post.topComments.length > 0 && (
                <div class="voices">
                  {post.topComments.map((c) => (
                    <blockquote class="voice">
                      <p class="voice-text">{c.text}</p>
                      <cite class="voice-cite">
                        &mdash; {c.author}
                        {c.score !== undefined && <span class="voice-score">{c.score} pts</span>}
                      </cite>
                    </blockquote>
                  ))}
                </div>
              )}
              
              {post.permalink && (
                <a href={post.permalink} class="thread-link" target="_blank" rel="noopener noreferrer">
                  Read full thread &#8599;
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
    
    <nav class="digest-nav">
      <hr class="nav-rule" />
      <a href="/" class="back-link">&larr; Back to Archives</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .digest {
    max-width: 1100px;
    margin: 0 auto;
  }

  .digest-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .digest-title {
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    color: var(--ink-muted);
  }

  /* Section chrome */
  .section {
    margin-bottom: 3rem;
  }

  .section-rule-container {
    margin-bottom: 1.5rem;
  }

  .section-rule {
    border: none;
    height: 3px;
    background: var(--rule);
    margin: 0 0 0.6rem;
  }

  .section-label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .section-label {
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
  }

  .section-source {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }

  /* Post grid layouts */
  .layout-featured {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0;
  }

  .layout-featured .post-lead {
    grid-row: 1 / -1;
    padding-right: 2rem;
    border-right: 1px solid var(--rule-light);
  }

  .layout-featured .post-standard {
    padding-left: 2rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule-faint);
  }

  .layout-featured .post-standard:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .layout-standard {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .layout-standard .post-standard:first-child {
    padding-right: 2rem;
    border-right: 1px solid var(--rule-light);
  }

  .layout-standard .post-standard:nth-child(2) {
    padding-left: 2rem;
  }

  .layout-standard .post-standard:only-child {
    grid-column: 1 / -1;
    padding-right: 0;
    border-right: none;
  }

  /* Post styles */
  .post-headline {
    font-family: var(--display);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.4rem;
    line-height: 1.25;
  }

  .post-lead .post-headline {
    font-size: 1.75rem;
  }

  .post-standard .post-headline {
    font-size: 1.25rem;
  }

  .post-headline a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-headline a:hover {
    color: var(--crimson);
  }

  .post-stats {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat-sep {
    margin: 0 0.35rem;
  }

  .post-body {
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-light);
  }

  .post-lead .post-body {
    font-size: 1.05rem;
  }

  /* Voices / quotes */
  .voices {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-faint);
  }

  .voice {
    margin: 0 0 1rem;
    padding: 0;
    border: none;
    position: relative;
  }

  .voice-text {
    margin: 0 0 0.3rem;
    font-size: 0.92rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--ink-light);
  }

  .voice-cite {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-style: normal;
    color: var(--ink-faint);
  }

  .voice-score {
    margin-left: 0.5rem;
    color: var(--ink-faint);
  }

  .voice-score::before {
    content: '\2022';
    margin-right: 0.5rem;
  }

  .thread-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crimson);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .thread-link:hover {
    text-decoration: underline;
  }

  /* Nav */
  .digest-nav {
    margin-top: 3rem;
    padding-bottom: 1rem;
    text-align: center;
  }

  .nav-rule {
    border: none;
    height: 1px;
    background: var(--rule);
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--crimson);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .layout-featured,
    .layout-standard {
      display: block;
    }

    .layout-featured .post-lead {
      padding-right: 0;
      border-right: none;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule-light);
    }

    .layout-featured .post-standard,
    .layout-standard .post-standard:first-child,
    .layout-standard .post-standard:nth-child(2) {
      padding-left: 0;
      padding-right: 0;
      border-right: none;
    }

    .layout-standard .post-standard {
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule-faint);
    }

    .post-lead .post-headline {
      font-size: 1.5rem;
    }

    .digest-title {
      font-size: 1.5rem;
    }
  }
</style>
