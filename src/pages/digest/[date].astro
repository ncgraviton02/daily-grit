---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const digests = await getCollection('digests');
  return digests.map((digest) => ({
    params: { date: digest.slug },
    props: { digest },
  }));
}

const { digest } = Astro.props;
const { data } = digest;

const sectionLabels: Record<string, string> = {
  'ai-agents': 'Artificial Intelligence',
  'claudecode': 'Developer Tools',
  'saas': 'Business & Startups',
  'digitalmarketing': 'Marketing & Growth',
  'philosophy': 'Ideas & Philosophy',
};
---

<BaseLayout title={`${data.title} | The Daily Grit`}>
  <Masthead date={data.date.toISOString()} showTagline={false} />
  
  <article class="digest">
    <header class="digest-header">
      <h1 class="digest-title">{data.title}</h1>
    </header>

    {/* Hero: Artwork + Poem (left) | Grit Story (right) */}
    {(data.artwork || data.grit) && (
      <section class="hero-features">
        {data.artwork && (
          <div class="hero-artwork">
            <div class="artwork-frame">
              <img src={data.artwork.image} alt="Artwork of the Day" loading="eager" />
            </div>
            <div class="artwork-poem">
              <h4 class="feature-label">Artwork of the Day</h4>
              <pre class="poem">{data.artwork.poem}</pre>
            </div>
          </div>
        )}
        {data.grit && (
          <div class="hero-grit">
            <h4 class="feature-label">Faces of Grit</h4>
            <div class="grit-portrait">
              <img src={data.grit.portrait} alt={`Portrait of ${data.grit.name}`} loading="eager" />
            </div>
            <h3 class="grit-name">{data.grit.name}</h3>
            <p class="grit-tagline">{data.grit.tagline}</p>
            <div class="grit-story">{data.grit.story}</div>
          </div>
        )}
      </section>
    )}
    
    {data.sections.map((section, si) => (
      <section class="section">
        <div class="section-rule-container">
          <hr class="section-rule" />
          <div class="section-label-row">
            <span class="section-label">{sectionLabels[section.icon] || section.name}</span>
            <span class="section-source">{section.name}</span>
          </div>
        </div>
        
        {/* Lead story — full width, with image floated left */}
        {section.posts[0] && (
          <article class="post post-lead">
            {section.image && (
              <div class="lead-image">
                <img src={section.image} alt={`Editorial illustration for ${section.name}`} loading="lazy" />
              </div>
            )}
            <h3 class="post-headline">
              {section.posts[0].permalink ? (
                <a href={section.posts[0].permalink} target="_blank" rel="noopener noreferrer">{section.posts[0].title}</a>
              ) : section.posts[0].title}
            </h3>
            <div class="post-stats">
              <span class="stat">{section.posts[0].score} points</span>
              <span class="stat-sep">&middot;</span>
              <span class="stat">{section.posts[0].comments} comments</span>
            </div>
            <p class="post-body">{section.posts[0].summary}</p>
            {section.posts[0].topComments && section.posts[0].topComments.length > 0 && (
              <div class="voices">
                {section.posts[0].topComments.map((c) => (
                  <blockquote class="voice">
                    <p class="voice-text">{c.text}</p>
                    <cite class="voice-cite">&mdash; {c.author}{c.score !== undefined && <span class="voice-score">{c.score} pts</span>}</cite>
                  </blockquote>
                ))}
              </div>
            )}
            {section.posts[0].permalink && (
              <a href={section.posts[0].permalink} class="thread-link" target="_blank" rel="noopener noreferrer">Read full thread &#8599;</a>
            )}
          </article>
        )}

        {/* Remaining stories — side by side */}
        {section.posts.length > 1 && (
          <div class="remaining-posts">
            {section.posts.slice(1).map((post) => (
              <article class="post post-standard">
                <h3 class="post-headline">
                  {post.permalink ? (
                    <a href={post.permalink} target="_blank" rel="noopener noreferrer">{post.title}</a>
                  ) : post.title}
                </h3>
                <div class="post-stats">
                  <span class="stat">{post.score} points</span>
                  <span class="stat-sep">&middot;</span>
                  <span class="stat">{post.comments} comments</span>
                </div>
                <p class="post-body">{post.summary}</p>
                {post.topComments && post.topComments.length > 0 && (
                  <div class="voices">
                    {post.topComments.map((c) => (
                      <blockquote class="voice">
                        <p class="voice-text">{c.text}</p>
                        <cite class="voice-cite">&mdash; {c.author}{c.score !== undefined && <span class="voice-score">{c.score} pts</span>}</cite>
                      </blockquote>
                    ))}
                  </div>
                )}
                {post.permalink && (
                  <a href={post.permalink} class="thread-link" target="_blank" rel="noopener noreferrer">Read full thread &#8599;</a>
                )}
              </article>
            ))}
          </div>
        )}
      </section>
    ))}
    
    <nav class="digest-nav">
      <hr class="nav-rule" />
      <a href="/" class="back-link">&larr; Back to Archives</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .digest {
    max-width: 1100px;
    margin: 0 auto;
  }

  .digest-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .digest-title {
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    color: var(--ink-muted);
  }

  /* Hero features: Artwork + Grit Story */
  .hero-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid var(--rule);
  }

  .hero-artwork {
    padding-right: 2.5rem;
    border-right: 1px solid var(--rule-light);
  }

  .artwork-frame {
    margin-bottom: 1.25rem;
    overflow: hidden;
  }

  .artwork-frame img {
    width: 100%;
    display: block;
  }

  .artwork-poem {
    /* poem area */
  }

  .feature-label {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--crimson);
    margin: 0 0 0.75rem;
  }

  .poem {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--ink-light);
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .hero-grit {
    padding-left: 2.5rem;
  }

  .grit-portrait {
    width: 180px;
    height: 180px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .grit-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .grit-name {
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 900;
    margin: 0 0 0.25rem;
    line-height: 1.2;
  }

  .grit-tagline {
    font-family: var(--display);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink-muted);
    margin: 0 0 1rem;
  }

  .grit-story {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-light);
  }

  @media (max-width: 768px) {
    .hero-features {
      grid-template-columns: 1fr;
    }

    .hero-artwork {
      padding-right: 0;
      border-right: none;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule-light);
    }

    .hero-grit {
      padding-left: 0;
    }

    .grit-portrait {
      width: 140px;
      height: 140px;
    }
  }

  /* Section chrome */
  .section {
    margin-bottom: 3rem;
  }

  .section-rule-container {
    margin-bottom: 1.5rem;
  }

  .section-rule {
    border: none;
    height: 3px;
    background: var(--rule);
    margin: 0 0 0.6rem;
  }

  .section-label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .section-label {
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
  }

  .section-source {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }

  /* Lead image — square, floated left */
  .lead-image {
    float: left;
    width: 260px;
    height: 260px;
    margin: 0.25rem 2rem 1rem 0;
    overflow: hidden;
  }

  .lead-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(20%) contrast(1.05);
  }

  @media (max-width: 768px) {
    .lead-image {
      float: none;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      max-width: 280px;
      margin: 0 0 1rem 0;
    }
  }

  /* Lead story — full width, prominent */
  .post-lead {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule-light);
    overflow: hidden; /* clear float */
  }

  /* Remaining posts — side by side columns */
  .remaining-posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .remaining-posts .post-standard:nth-child(odd) {
    padding-right: 2rem;
    border-right: 1px solid var(--rule-light);
  }

  .remaining-posts .post-standard:nth-child(even) {
    padding-left: 2rem;
  }

  .remaining-posts .post-standard {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }

  /* Single remaining post spans full width */
  .remaining-posts:has(.post-standard:only-child) {
    grid-template-columns: 1fr;
  }

  .remaining-posts .post-standard:only-child {
    padding-right: 0;
    border-right: none;
  }

  /* Post styles */
  .post-headline {
    font-family: var(--display);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.4rem;
    line-height: 1.25;
  }

  .post-lead .post-headline {
    font-size: 1.75rem;
  }

  .post-standard .post-headline {
    font-size: 1.25rem;
  }

  .post-headline a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-headline a:hover {
    color: var(--crimson);
  }

  .post-stats {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat-sep {
    margin: 0 0.35rem;
  }

  .post-body {
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-light);
  }

  .post-lead .post-body {
    font-size: 1.05rem;
  }

  /* Voices / quotes */
  .voices {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-faint);
  }

  .voice {
    margin: 0 0 1rem;
    padding: 0;
    border: none;
    position: relative;
  }

  .voice-text {
    margin: 0 0 0.3rem;
    font-size: 0.92rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--ink-light);
  }

  .voice-cite {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-style: normal;
    color: var(--ink-faint);
  }

  .voice-score {
    margin-left: 0.5rem;
    color: var(--ink-faint);
  }

  .voice-score::before {
    content: '\2022';
    margin-right: 0.5rem;
  }

  .thread-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crimson);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .thread-link:hover {
    text-decoration: underline;
  }

  /* Nav */
  .digest-nav {
    margin-top: 3rem;
    padding-bottom: 1rem;
    text-align: center;
  }

  .nav-rule {
    border: none;
    height: 1px;
    background: var(--rule);
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--crimson);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .remaining-posts {
      grid-template-columns: 1fr;
    }

    .remaining-posts .post-standard:nth-child(odd) {
      padding-right: 0;
      border-right: none;
    }

    .remaining-posts .post-standard:nth-child(even) {
      padding-left: 0;
    }

    .remaining-posts .post-standard {
      border-bottom: 1px solid var(--rule-faint);
    }

    .post-lead .post-headline {
      font-size: 1.5rem;
    }

    .digest-title {
      font-size: 1.5rem;
    }
  }
</style>
