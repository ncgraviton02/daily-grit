---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import { getCollection } from 'astro:content';

const digests = await getCollection('digests');
const sortedDigests = digests.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const digestDates = new Set(
  digests.map(digest => new Date(digest.data.date).toISOString().split('T')[0])
);

// Generate calendar for February 2026
const year = 2026;
const month = 1; // 0-indexed
const firstDay = new Date(year, month, 1);
const lastDay = new Date(year, month + 1, 0);
const firstDayOfWeek = firstDay.getDay();
const daysInMonth = lastDay.getDate();
const monthName = firstDay.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const calendarDays: { day: string; hasContent: boolean; date: string }[] = [];
for (let i = 0; i < firstDayOfWeek; i++) {
  calendarDays.push({ day: '', hasContent: false, date: '' });
}
for (let day = 1; day <= daysInMonth; day++) {
  const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
  calendarDays.push({ day: day.toString(), hasContent: digestDates.has(dateStr), date: dateStr });
}

const sectionLabels: Record<string, string> = {
  'ai-agents': 'AI',
  'claudecode': 'Dev',
  'saas': 'SaaS',
  'digitalmarketing': 'Marketing',
  'philosophy': 'Philosophy',
};
---

<BaseLayout title="The Daily Grit">
  <Masthead />
  
  <!-- Latest digest hero -->
  {sortedDigests.length > 0 && (() => {
    const latest = sortedDigests[0];
    const leadHeadline = latest.data.headlines?.[0];
    const leadSection = latest.data.sections[0];
    const leadPost = leadSection?.posts[0];
    const topStory = leadHeadline || leadPost;
    return (
      <section class="hero">
        <div class="hero-lead">
          <span class="hero-kicker">Latest Edition</span>
          <h2 class="hero-headline">
            <a href={`/digest/${latest.slug}`}>{latest.data.title}</a>
          </h2>
          {topStory && (
            <p class="hero-summary">
              <strong>{topStory.title}</strong> &mdash; {topStory.summary.slice(0, 200)}...
            </p>
          )}
          <a href={`/digest/${latest.slug}`} class="hero-read">Read this edition &#8599;</a>
        </div>
        <div class="hero-sidebar">
          <h4 class="hero-sidebar-title">In this edition</h4>
          <ul class="hero-topics">
            {latest.data.headlines && latest.data.headlines.length > 0 && (
              <li class="hero-topic">Headlines: {latest.data.headlines.length} stories</li>
            )}
            {latest.data.deepReads && latest.data.deepReads.length > 0 && (
              <li class="hero-topic">Deep Reads: {latest.data.deepReads.length} analysis pieces</li>
            )}
            {latest.data.sections.map(s => (
              <li class="hero-topic">{sectionLabels[s.icon] || s.name}: {s.posts[0]?.title}</li>
            ))}
            {latest.data.launches && latest.data.launches.length > 0 && (
              <li class="hero-topic">Launches: {latest.data.launches.length} products</li>
            )}
            {latest.data.watchLater && latest.data.watchLater.length > 0 && (
              <li class="hero-topic">Watch Later: {latest.data.watchLater.length} videos</li>
            )}
          </ul>
        </div>
      </section>
    );
  })()}

  <hr class="content-rule" />

  <div class="archives-layout">
    <!-- Calendar -->
    <div class="calendar-panel">
      <h3 class="panel-title">Archives</h3>
      <p class="panel-subtitle">{monthName}</p>
      <div class="cal-grid">
        <span class="cal-head">S</span><span class="cal-head">M</span><span class="cal-head">T</span>
        <span class="cal-head">W</span><span class="cal-head">T</span><span class="cal-head">F</span>
        <span class="cal-head">S</span>
        {calendarDays.map(({ day, hasContent, date }) => (
          hasContent ? (
            <a href={`/digest/${date}`} class="cal-day cal-active">{day}</a>
          ) : (
            <span class={`cal-day ${!day ? 'cal-empty' : ''}`}>{day}</span>
          )
        ))}
      </div>
    </div>

    <!-- Recent editions list -->
    <div class="editions-panel">
      <h3 class="panel-title">Recent Editions</h3>
      <div class="editions-list">
        {sortedDigests.slice(0, 7).map(digest => {
          const d = new Date(digest.data.date);
          const dayName = d.toLocaleDateString('en-US', { weekday: 'short' });
          const monthDay = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
          const totalStories = (digest.data.headlines?.length || 0) + 
                               (digest.data.deepReads?.length || 0) + 
                               (digest.data.launches?.length || 0) + 
                               (digest.data.watchLater?.length || 0) +
                               digest.data.sections.reduce((sum, s) => sum + s.posts.length, 0);
          return (
            <a href={`/digest/${digest.slug}`} class="edition-row">
              <span class="edition-date">
                <span class="edition-day">{dayName}</span>
                <span class="edition-monthday">{monthDay}</span>
              </span>
              <span class="edition-sections">
                {digest.data.headlines && digest.data.headlines.length > 0 && (
                  <span class="edition-tag">Headlines</span>
                )}
                {digest.data.deepReads && digest.data.deepReads.length > 0 && (
                  <span class="edition-tag">Analysis</span>
                )}
                {digest.data.sections.map(s => (
                  <span class="edition-tag">{sectionLabels[s.icon] || s.name}</span>
                ))}
                {digest.data.launches && digest.data.launches.length > 0 && (
                  <span class="edition-tag">Launches</span>
                )}
                {digest.data.watchLater && digest.data.watchLater.length > 0 && (
                  <span class="edition-tag">Videos</span>
                )}
              </span>
              <span class="edition-count">{totalStories} stories</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 0;
    margin-bottom: 2rem;
  }

  .hero-lead {
    padding-right: 2.5rem;
    border-right: 1px solid var(--rule-light);
  }

  .hero-kicker {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--crimson);
    display: block;
    margin-bottom: 0.5rem;
  }

  .hero-headline {
    font-family: var(--display);
    font-size: 2.2rem;
    font-weight: 900;
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .hero-headline a {
    color: var(--ink);
    text-decoration: none;
  }

  .hero-headline a:hover {
    color: var(--crimson);
  }

  .hero-summary {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-light);
    margin: 0 0 1rem;
  }

  .hero-read {
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--crimson);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-read:hover {
    text-decoration: underline;
  }

  .hero-sidebar {
    padding-left: 2.5rem;
  }

  .hero-sidebar-title {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin: 0 0 1rem;
  }

  .hero-topics {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-topic {
    font-size: 0.92rem;
    line-height: 1.5;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule-faint);
    color: var(--ink-light);
  }

  .hero-topic:last-child {
    border-bottom: none;
  }

  /* Content rule */
  .content-rule {
    border: none;
    height: 3px;
    background: var(--rule);
    margin: 0 0 2rem;
  }

  /* Archives layout */
  .archives-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 0;
    margin-bottom: 2rem;
  }

  .calendar-panel {
    padding-right: 2.5rem;
    border-right: 1px solid var(--rule-light);
  }

  .editions-panel {
    padding-left: 2.5rem;
  }

  .panel-title {
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    margin: 0 0 0.25rem;
  }

  .panel-subtitle {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin: 0 0 1.25rem;
  }

  /* Calendar */
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0;
    text-align: center;
  }

  .cal-head {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-muted);
    padding: 0.4rem 0;
    text-transform: uppercase;
    border-bottom: 1px solid var(--rule-faint);
  }

  .cal-day {
    font-family: var(--sans);
    font-size: 0.85rem;
    padding: 0.55rem 0;
    color: var(--ink-muted);
  }

  .cal-empty {
    color: transparent;
  }

  .cal-active {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    position: relative;
  }

  .cal-active::after {
    content: '';
    display: block;
    width: 4px;
    height: 4px;
    background: var(--crimson);
    border-radius: 50%;
    margin: 2px auto 0;
  }

  .cal-active:hover {
    color: var(--crimson);
  }

  /* Editions list */
  .editions-list {
    display: flex;
    flex-direction: column;
  }

  .edition-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule-faint);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.1s ease;
  }

  .edition-row:hover {
    background: var(--paper-warm);
  }

  .edition-row:last-child {
    border-bottom: none;
  }

  .edition-date {
    display: flex;
    flex-direction: column;
    min-width: 60px;
  }

  .edition-day {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .edition-monthday {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }

  .edition-sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    flex: 1;
  }

  .edition-tag {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule-light);
    color: var(--ink-muted);
  }

  .edition-count {
    font-family: var(--sans);
    font-size: 0.75rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      display: block;
    }

    .hero-lead {
      padding-right: 0;
      border-right: none;
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--rule-light);
    }

    .hero-sidebar {
      padding-left: 0;
    }

    .hero-headline {
      font-size: 1.75rem;
    }

    .archives-layout {
      display: block;
    }

    .calendar-panel {
      padding-right: 0;
      border-right: none;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--rule-light);
    }

    .editions-panel {
      padding-left: 0;
    }

    .edition-sections {
      display: none;
    }
  }
</style>
