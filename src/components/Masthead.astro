---
export interface Props {
  date?: string;
  showTagline?: boolean;
}

const { date, showTagline = true } = Astro.props;

const formatDate = (dateStr?: string) => {
  const d = dateStr ? new Date(dateStr) : new Date();
  return d.toLocaleDateString('en-US', { 
    weekday: 'long', 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};
---

<header class="masthead">
  <div class="masthead-top-rule"></div>
  <div class="masthead-inner">
    <div class="masthead-left">
      <span class="edition-label">Daily Edition</span>
    </div>
    <div class="masthead-center">
      <h1 class="nameplate">The Daily Grit</h1>
      {showTagline && <p class="tagline">"All the Signal That's Fit to Print"</p>}
    </div>
    <div class="masthead-right">
      <span class="date-line">{formatDate(date)}</span>
    </div>
  </div>
  <div class="masthead-bottom-rule"></div>
</header>

<style>
  .masthead {
    margin-bottom: 2rem;
    padding-top: 1.5rem;
  }

  .masthead-top-rule {
    height: 4px;
    background: var(--rule);
    margin-bottom: 2px;
  }

  .masthead-top-rule::after {
    content: '';
    display: block;
    height: 1px;
    background: var(--rule);
    margin-top: 2px;
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
  }

  .masthead-left, .masthead-right {
    flex: 1;
    font-family: var(--sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
  }

  .masthead-right {
    text-align: right;
  }

  .masthead-center {
    flex: 2;
    text-align: center;
  }

  .nameplate {
    font-family: var(--display);
    font-size: 3.5rem;
    font-weight: 900;
    margin: 0;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--ink);
  }

  .tagline {
    font-family: var(--display);
    font-size: 0.95rem;
    font-style: italic;
    margin: 0.4rem 0 0;
    color: var(--ink-muted);
    font-weight: 400;
  }

  .edition-label {
    font-weight: 600;
  }

  .date-line {
    font-weight: 400;
  }

  .masthead-bottom-rule {
    height: 2px;
    background: var(--rule);
    margin-bottom: 2px;
  }

  .masthead-bottom-rule::after {
    content: '';
    display: block;
    height: 1px;
    background: var(--rule);
    margin-top: 2px;
  }

  @media (max-width: 768px) {
    .masthead-inner {
      flex-direction: column;
      gap: 0.5rem;
      padding: 1rem 0;
    }

    .masthead-left, .masthead-right {
      text-align: center;
    }

    .nameplate {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .nameplate {
      font-size: 2rem;
    }

    .masthead-left {
      display: none;
    }
  }
</style>
